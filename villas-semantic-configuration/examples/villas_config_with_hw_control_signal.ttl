<http://example.org/components/building-fmu>
    a oeo:OEO_00420006 ;
    oeo:OEO_0042XXXX-has_connection_port
        [
            a oeo:OEO_0042XXXX-simulation_connection_input_port ;
            oeo:OEO_0042XXXX-has_message_schema
                [
                    a oeo:OEO_0042XXXX-message_schema ;
                    oeo:OEO_0042XXXX-has_message_attribute (
                        
                        [
                            a oeo:OEO_0042XXXX-message_attribute ;
                            vil:field_type "float"^^<xsd:string> ;
                            ns1:label "float_0"^^<xsd:string> ;
                        ]
                        
                        [
                            a oeo:OEO_0042XXXX-message_attribute ;
                            vil:field_type "float"^^<xsd:string> ;
                            ns1:label "float_1"^^<xsd:string> ;
                        ]
                        
                        [
